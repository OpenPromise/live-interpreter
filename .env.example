# 阿里云百炼（DashScope）API Key（必填）
DASHSCOPE_API_KEY=sk-your-key-here

# 百炼业务空间 ID（百炼控制台首页可查）
QWEN_WORKSPACE_ID=your-workspace-id

# 地域：cn-beijing（华北2/北京）或 ap-southeast-1（新加坡）
QWEN_REGION=cn-beijing

# 模型（默认官方推荐模型，一般不用改）
QWEN_MODEL=qwen3.5-livetranslate-flash-realtime

# 目标输出语言（29 种支持语音输出，默认中文）
OUTPUT_LANGUAGE=zh

# 输出音色（官方 53 个之一，如 Serena/Ethan/Cherry/Mia，留空用模型默认）
QWEN_VOICE=

# 声音复刻：never=不启用（用预设音色）/ once=服务端复刻一次 / always=每次复刻
QWEN_VOICE_CLONE=never

# 热词表（JSON 字典，源语言词 -> 目标语言词）
QWEN_HOTWORDS={"NVIDIA":"英伟达"}

# 源语言提示（留空则自动识别）
QWEN_SOURCE_LANGUAGE=

# VAD 静音判定阈值（毫秒）。默认 1000；快语速/短停顿内容可调小到 300~500
# QWEN_VAD_SILENCE_MS=400

# 可选：覆盖 WebSocket 地址（网关/调试用）
# 业务空间专属域名（推荐，若报 IllegalEndpoint 程序会自动回退公共域名）：
# QWEN_WS_URL=wss://your-workspace-id.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime?model=qwen3.5-livetranslate-flash-realtime
# 公共域名（部分账号业务空间域名不可用时用这个）：
# QWEN_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime?model=qwen3.5-livetranslate-flash-realtime

# 可选：抓流代理（国内访问 YouTube/Twitch 通常需要）
# PROXY=http://127.0.0.1:7890
